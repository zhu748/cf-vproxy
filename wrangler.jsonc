{
  // Worker 名称（也是默认的 *.workers.dev 子域名前缀），可自行修改
  "name": "cf-vproxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // 允许使用部分 Node 风格 API（Buffer 兼容等）
  "compatibility_flags": ["nodejs_compat"],
  // 观测：Dashboard 上可直接看请求日志，免费计划可用
  "observability": {
    "enabled": true
  },
  // ⚠️ 部署前必须：先 `wrangler kv namespace create VPROXY_KV`，
  // 然后把下面 id 换成命令输出的真实 id
  "kv_namespaces": [
    {
      "binding": "VPROXY_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  // 非敏感配置可以放 vars（敏感的一律用 `wrangler secret put`）
  "vars": {},
  // 免费计划 CPU 限制为 10ms/请求，纯 JSON 转换足够；无需额外设置
}
